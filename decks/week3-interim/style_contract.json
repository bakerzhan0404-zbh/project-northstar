{
  "workspace_version": 2,
  "deck_title": "Project Northstar — Week 3 Interim Steering Review",
  "deck_slug": "project-northstar-week3-interim-steering",
  "format": {
    "aspect_ratio": "16:9",
    "slide_count": 10,
    "editable_objects_required": true,
    "speaker_notes_required": true,
    "external_imagery_allowed": false
  },
  "build": {
    "style_preset": "data-heavy-boardroom",
    "font_pair": "clean_modern_v1",
    "output_pptx": "build/project-northstar-week3-interim-steering.pptx",
    "qa_dir": "build/qa",
    "qa_report": "build/qa/report.json"
  },
  "composition": {
    "primary_grammar": "board-risk memo",
    "page_system": "board-ledger",
    "secondary_influence": "lab-results evidence grammar",
    "style_seed": "northstar-week3-steering-v1",
    "role_sequence": [
      "title-decision",
      "evidence-table",
      "option-chart",
      "operating-system-table",
      "pilot-results-table",
      "pilot-results-table",
      "value-ledger-table",
      "falsification-comparison",
      "risk-owner-table",
      "decision-timeline"
    ],
    "max_consecutive_same_variant": 2
  },
  "tokens": {
    "palette": {
      "background": "#F8FAFC",
      "dark": "#0F172A",
      "surface": "#FFFFFF",
      "text": "#111827",
      "muted": "#4B5563",
      "accent_primary": "#1D4ED8",
      "accent_secondary": "#0891B2",
      "warning": "#B45309",
      "line": "#D1D5DB"
    },
    "typography": {
      "title_pt": "30–40",
      "section_pt": "22–28",
      "body_pt": "15–22",
      "caption_pt": "10–12",
      "letter_spacing": 0
    },
    "layout": {
      "margin_x_in": 0.65,
      "top_safe_in": 0.9,
      "bottom_safe_in": 0.34,
      "gutter_in": 0.24,
      "radius_style": "rectangle"
    }
  },
  "layout_rules": {
    "alignment_first": true,
    "zero_overlap_required": true,
    "title_subtitle_stack_dynamic": true,
    "footer_safe_region_required": true,
    "single_dominant_object_required": true,
    "tables_max_body_rows": 5,
    "tables_max_columns": 4,
    "source_line_on_every_slide": true
  },
  "semantic_color_rules": {
    "preferred_direction": "accent_primary",
    "governed_local_right": "accent_secondary",
    "open_or_caution": "warning",
    "diagnostic_not_validated": "muted",
    "recognized_value": "text"
  },
  "forbidden_moves": [
    "external or generated imagery",
    "benefit totals",
    "readiness averages",
    "score-as-confidence encoding",
    "automatic-launch arrow",
    "body text below 15 pt",
    "caption text below 10 pt"
  ]
}
